{
  "name": "8090-night-arcade",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "node scripts/build-ads.mjs && vinext build",
    "preview": "vite preview --host 127.0.0.1 --port 3000",
    "deploy": "CLOUDFLARE_ENV=production npm run build && wrangler deploy --config dist/server/wrangler.json",
    "deploy:preview": "CLOUDFLARE_ENV=preview npm run build && wrangler deploy --config dist/server/wrangler.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed": "node scripts/seed.mjs",
    "setup": "node scripts/setup.mjs && npm run db:migrate && npm run db:seed",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "deploy:production": "CLOUDFLARE_ENV=production npm run build && wrangler deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "drizzle-orm": "^0.45.1",
    "fast-xml-parser": "^5.3.8",
    "jose": "^6.1.3",
    "lucide-react": "^0.577.0",
    "next": "16.3.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitejs/plugin-rsc": "^0.5.35",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.9.8",
    "react-server-dom-webpack": "^19.2.6",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vinext": "1.0.0-beta.10",
    "vite": "^8.0.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.135.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
